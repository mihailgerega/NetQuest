APP_ENV=local
SERVICE_NAME=netquest-api

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s
MAX_REQUEST_BODY_BYTES=1048576
JSON_BODY_LIMIT_BYTES=1048576
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DSN=postgres://netquest:netquest@localhost:5432/netquest?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_CONN_MAX_LIFETIME=1h

REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

NATS_URL=nats://localhost:4222
NATS_TIMEOUT=2s

JWT_ISSUER=netquest
JWT_SECRET=local-dev-secret-change-before-production-32
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_HASH_COST=12
SECURE_COOKIE=false
DEMO_AUTH_ENABLED=true
HEALTH_DEEP_TIMEOUT=3s

RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_BURST=30
RATE_LIMIT_REDIS_PREFIX=netquest:rl

MIGRATIONS_DIR=migrations

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_REPOSITORY_URL=
