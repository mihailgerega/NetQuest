APP_ENV=production
SERVICE_NAME=netquest-api

PUBLIC_APP_URL=https://net-quest.ru
FRONTEND_URL=http://frontend:3000
BACKEND_PUBLIC_URL=https://net-quest.ru
API_BASE_URL=https://net-quest.ru
NEXT_PUBLIC_API_BASE_URL=https://net-quest.ru
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/<owner>/<repo>

HTTP_ADDR=:8080
POSTGRES_DSN=postgres://netquest:change-me@postgres:5432/netquest?sslmode=disable
DATABASE_URL=postgres://netquest:change-me@postgres:5432/netquest?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

JWT_ISSUER=netquest
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SECURE_COOKIE=true
CORS_ALLOWED_ORIGINS=https://net-quest.ru
DEMO_AUTH_ENABLED=true

POSTGRES_DB=netquest
POSTGRES_USER=netquest
POSTGRES_PASSWORD=change-me

DOMAIN=net-quest.ru
ACME_EMAIL=admin@net-quest.ru
